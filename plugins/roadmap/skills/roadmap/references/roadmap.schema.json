{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/doyled-it/claude-skills/plugins/roadmap/roadmap.schema.json",
  "title": "Roadmap",
  "description": "The agreed plan for a program, on one page. roadmap.json is the source of truth; the forge tracks the work for the team and Orca runs it. `roadmap validate` also checks what a schema cannot: dependency cycles, dangling dependencies, and the glossary.",
  "type": "object",
  "required": [
    "title",
    "version",
    "date",
    "agreed",
    "goal",
    "rule",
    "gates",
    "epics",
    "issues"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Page title, for example \"Search service roadmap\"."
    },
    "version": {
      "type": "string",
      "description": "Roadmap version, for example \"Version 3\". Bump it when the agreed plan changes."
    },
    "date": {
      "type": "string",
      "description": "Date of this version."
    },
    "agreed": {
      "type": "boolean",
      "description": "True only after the program lead agreed this version. publish refuses a draft."
    },
    "agreed_by": {
      "type": "string",
      "description": "Who agreed it, shown on the page."
    },
    "goal": {
      "type": "string",
      "description": "What the program delivers, in one or two plain sentences."
    },
    "rule": {
      "type": "string",
      "description": "The working rule: work only from this roadmap; diverge only with approval or a stated good reason."
    },
    "allowed_terms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Words that look like codes but are ordinary terms for this program (for example GP3), so validate accepts them in titles and names."
    },
    "forge": {
      "type": "object",
      "description": "Where the team tracks the work. Optional: without it the git remote decides.",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "gitlab",
            "github",
            "forgejo",
            "gitea"
          ],
          "description": "forgejo covers Codeberg and Gitea."
        },
        "host": {
          "type": "string",
          "description": "For example gitlab.example.com or github.com."
        },
        "project": {
          "type": "string",
          "description": "Default project for new issues: group/project on GitLab, owner/repo on GitHub."
        },
        "group": {
          "type": "string",
          "description": "GitLab group that holds the epics."
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Extra projects whose open merge requests sync checks for drift."
        },
        "status_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Optional label per status, for example {\"blocked\": \"status::blocked\"}."
        },
        "gate_rules": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "mr_merged",
              "mr_green",
              "checklist"
            ]
          },
          "description": "How sync ticks a gate from forge evidence. Default: M ticks when a merged merge request in the roadmap's projects closes the issue (mr_merged). mr_green: such a merge request has a green pipeline. Every other gate ticks from its line in the generated checklist. Lead gates cannot have a rule."
        },
        "pin_epics": {
          "type": "boolean",
          "description": "Forgejo only: pin each epic's parent issue on the repository's issue list when a pin slot is free."
        }
      }
    },
    "orca": {
      "type": "object",
      "properties": {
        "run": {
          "type": "string",
          "description": "Legacy Orca run included alongside runs from orchestration.coordinators."
        }
      }
    },
    "orca_observation": {
      "type": "object",
      "description": "Optional snapshot saved by sync --write. Worker activity reflects the recorded observation times.",
      "required": ["source", "observed_at", "coverage_complete", "workers"],
      "properties": {
        "source": {
          "enum": ["live", "recorded"]
        },
        "observed_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Capture start time, or null when Unknown."
        },
        "coverage_complete": {
          "type": "boolean",
          "description": "Task coverage across all configured roadmap runs."
        },
        "configured_runs": {
          "type": "array",
          "items": {"type": "string", "pattern": "\\S"},
          "description": "Roadmap run IDs configured at capture time. Older snapshots omit this field."
        },
        "workers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["run", "task", "dispatch", "activity", "observed_at", "owners"],
            "properties": {
              "run": { "type": ["string", "null"], "pattern": "\\S" },
              "task": { "type": "string", "pattern": "\\S" },
              "dispatch": { "type": ["string", "null"], "pattern": "\\S" },
              "activity": {
                "enum": ["working", "waiting", "idle", "queued", "stopped", "unknown"]
              },
              "observed_at": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "owners": {
                "type": "object",
                "propertyNames": { "pattern": "\\S" },
                "additionalProperties": { "type": ["string", "null"], "pattern": "\\S" }
              }
            },
            "if": {
              "properties": { "activity": { "not": { "const": "unknown" } } }
            },
            "then": {
              "properties": {
                "run": { "type": "string" },
                "dispatch": { "type": "string" },
                "observed_at": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "orchestration": {
      "type": "object",
      "properties": {
        "coordinators": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/coordinatorKey"
          },
          "additionalProperties": {
            "$ref": "#/$defs/coordinator"
          }
        },
        "levels": {
          "$ref": "#/$defs/levels"
        }
      }
    },
    "gates": {
      "type": "object",
      "description": "Gate letter to what it checks. Projects may define their own set.",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^[A-Z]$"
      }
    },
    "lead_gates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]$"
      },
      "description": "Gates only the program lead can pass (default D and U). They pass only from an approval recorded on the gate (approved_by, approved_on), never from the forge."
    },
    "iterations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          }
        }
      }
    },
    "epics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/epic"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "timeline": {
      "type": "array",
      "description": "Roadmap history in source order, oldest top-level event first. Related children are shown in their recorded order.",
      "items": {
        "$ref": "#/$defs/timelineEvent"
      }
    },
    "page_url": {
      "type": "string",
      "description": "Where readers can open the full roadmap page, linked from each epic's generated section. Leave it out when the page stays on the program lead's machine."
    }
  },
  "$defs": {
    "levels": {
      "type": "object",
      "description": "The lead's answer to the kickoff level question (references/levels.md): the model and effort for each orchestration level and the parallel epic cap. Every later session and handoff reuses it.",
      "required": [
        "program",
        "epic",
        "worker",
        "parallel_epics"
      ],
      "additionalProperties": false,
      "properties": {
        "program": {
          "$ref": "#/$defs/tier",
          "description": "Level 1: the program orchestrator the user talks to."
        },
        "epic": {
          "$ref": "#/$defs/tier",
          "description": "Level 2: each epic lead."
        },
        "worker": {
          "type": "object",
          "description": "Level 3: one choice per worker role. implementer and reviewer are required; mechanical (cheap, exact edits) and final_reviewer are usual; other roles are named exceptions.",
          "required": [
            "implementer",
            "reviewer"
          ],
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/tier"
          }
        },
        "parallel_epics": {
          "type": "integer",
          "minimum": 1,
          "description": "How many epic leads may run at once. Default 2."
        },
        "answered_by": {
          "type": "string",
          "pattern": "\\S",
          "description": "Who answered the level question."
        },
        "answered_on": {
          "type": "string",
          "pattern": "\\S",
          "description": "When it was answered."
        }
      }
    },
    "tier": {
      "type": "object",
      "description": "One model choice.",
      "required": [
        "model"
      ],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "pattern": "\\S",
          "description": "The model id or alias the agent accepts, for example with --model."
        },
        "effort": {
          "type": "string",
          "pattern": "\\S",
          "description": "Reasoning effort in the agent's own words, for example high or medium."
        },
        "agent": {
          "type": "string",
          "pattern": "\\S",
          "description": "Agent to run, when it differs from the one starting the worker."
        },
        "note": {
          "type": "string",
          "pattern": "\\S",
          "description": "When this choice applies, or a named exception."
        }
      }
    },
    "timelineEvent": {
      "type": "object",
      "required": [
        "date",
        "text"
      ],
      "properties": {
        "date": {
          "type": "string",
          "description": "Original timestamp or date as recorded."
        },
        "text": {
          "type": "string",
          "description": "Full original event record."
        },
        "title": {
          "type": "string",
          "description": "Short outcome shown in the collapsed timeline."
        },
        "author": {
          "type": "string",
          "pattern": "[^ ]",
          "not": {
            "pattern": "[A-Z]|[^ -~]"
          },
          "description": "Non-blank printable ASCII author text without uppercase letters. The renderer recognizes claude and codex."
        },
        "id": {
          "type": "string",
          "description": "Stable identity for this event when supplied."
        },
        "provenance": {
          "type": "object",
          "description": "Recorded source or attribution evidence."
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timelineEvent"
          }
        }
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "description": "Short readable name: lowercase words joined by hyphens. Never a code like A1 or T1.1."
    },
    "coordinatorKey": {
      "type": "string",
      "pattern": "\\S"
    },
    "coordinator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "scope": {
          "type": "string",
          "pattern": "\\S"
        },
        "run": {
          "type": "string",
          "pattern": "\\S",
          "description": "Orca run to include in sync."
        },
        "role": {
          "enum": ["meta", "area", "worker"]
        },
        "parent": {
          "$ref": "#/$defs/coordinatorKey",
          "description": "Key of the parent coordinator. Parent chains must be acyclic."
        }
      }
    },
    "orchestrators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coordinatorKey"
      },
      "description": "Keys in orchestration.coordinators for the coordinators responsible for this work."
    },
    "epic": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "orchestrators": {
          "$ref": "#/$defs/orchestrators"
        },
        "parent": {
          "$ref": "#/$defs/slug",
          "description": "Parent epic, for an issue that grew into a child epic."
        },
        "ref": {
          "type": "string",
          "description": "Forge reference once published: group&12 on GitLab, owner/repo#12 on GitHub."
        },
        "url": {
          "type": "string"
        }
      }
    },
    "gate": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]$"
        },
        {
          "type": "object",
          "required": [
            "gate"
          ],
          "properties": {
            "gate": {
              "type": "string",
              "pattern": "^[A-Z]$"
            },
            "passed": {
              "type": "boolean"
            },
            "evidence": {
              "type": "string",
              "description": "Link that shows the gate passed."
            },
            "approved_by": {
              "type": "string",
              "minLength": 1,
              "description": "Who approved a lead gate. Required when a lead gate is passed."
            },
            "approved_on": {
              "type": "string",
              "description": "Date of that approval."
            }
          }
        }
      ]
    },
    "issue": {
      "type": "object",
      "required": [
        "id",
        "title",
        "epic",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "description": "What the issue delivers, in plain words."
        },
        "detail": {
          "type": "string"
        },
        "epic": {
          "$ref": "#/$defs/slug"
        },
        "orchestrators": {
          "$ref": "#/$defs/orchestrators"
        },
        "status": {
          "enum": [
            "to_do",
            "in_progress",
            "in_review",
            "blocked",
            "done"
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          },
          "description": "Issues that must be Done first (the forge's \"blocked by\")."
        },
        "gates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gate"
          }
        },
        "project": {
          "type": "string",
          "description": "Forge project for this issue when it differs from forge.project."
        },
        "ref": {
          "type": "string",
          "description": "Forge reference once published, for example group/project#12."
        },
        "url": {
          "type": "string"
        },
        "iteration": {
          "type": "string"
        },
        "estimate_days": {
          "type": "number",
          "maximum": 10,
          "description": "Working days. More than ten means it becomes a child epic."
        },
        "links": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "merge_requests": {
          "type": "array",
          "description": "Written by sync --write: the issue's merge requests, with state and pipeline, each linking to the forge.",
          "items": {
            "type": "object",
            "required": [
              "ref"
            ],
            "properties": {
              "ref": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "open",
                  "merged",
                  "closed"
                ]
              },
              "draft": {
                "type": "boolean"
              },
              "pipeline": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pipeline_url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
