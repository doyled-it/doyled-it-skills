{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/roadmap/scripts/python.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/roadmap_hook.py\" post-tool-use",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/roadmap/scripts/python.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/roadmap_hook.py\" stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
